# Copy to .env for local testing with `netlify dev`.
# In production, set these in Netlify → Site configuration → Environment variables.
# Never commit real keys. Use sk_test_ keys until you are ready to take real payments.

# --- Stripe ---
STRIPE_SECRET_KEY=
# Optional: comma-separated ISO country codes you ship to (default: US)
STRIPE_SHIPPING_COUNTRIES=
# Optional: "true" once Stripe Tax is configured in the Stripe Dashboard
STRIPE_AUTOMATIC_TAX=

# --- Mailchimp ---
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Optional: data-center prefix such as us21 (read from the API key if omitted)
MAILCHIMP_SERVER_PREFIX=
# Optional: "false" to subscribe immediately instead of double opt-in
MAILCHIMP_DOUBLE_OPT_IN=

# --- Contact form (email delivery via Resend: https://resend.com) ---
RESEND_API_KEY=
# Inbox that receives contact-form messages
CONTACT_TO_EMAIL=
# Optional sender, e.g. "GLOWW <hello@your-domain.com>" (domain verified in Resend).
# Leave empty to use Resend's onboarding@resend.dev, which only delivers to the
# email address of the Resend account owner.
CONTACT_FROM_EMAIL=
